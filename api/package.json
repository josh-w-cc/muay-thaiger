{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*.js": "./*.js"
  },
  "scripts": {
    "dev": "node --watch index.js",
    "lint": "eslint --config config/eslint.config.js --fix .",
    "lint:ci": "eslint --config config/eslint.config.js .",
    "migrate": "knex migrate:latest --knexfile data/knexfile.js",
    "migrate:make": "knex migrate:make --knexfile data/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile data/knexfile.js",
    "migrate:seed": "knex seed:run --knexfile data/knexfile.js",
    "start": "node index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=95 --test-coverage-include=app.js --test-coverage-include=index.js --test-coverage-include=data/**/*.js --test-coverage-include=logic/**/*.js --test-coverage-include=routes/**/*.js --test-coverage-include=plugins/**/*.js --test-coverage-include=services/**/*.js --test-coverage-exclude=**/*.test.js --test-coverage-exclude=data/seed-data/** --test-coverage-exclude=data/utils/mock-knex.js"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5",
    "fastify-plugin": "^5",
    "knex": "^3.2.10",
    "pg": "^8.21.0",
    "shared": "file:../shared",
    "toad-scheduler": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@stylistic/eslint-plugin": "^5",
    "c8": "^11",
    "eslint": "^10",
    "globals": "^17"
  },
  "c8": {
    "branches": 95,
    "check-coverage": true,
    "exclude": [
      "**/*.test.js",
      "data/seed-data/**",
      "data/utils/mock-knex.js"
    ],
    "functions": 95,
    "lines": 95,
    "statements": 95
  }
}
